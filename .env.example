# GROWW Agent Environment Configuration
# DO NOT COMMIT this file if it contains actual keys. 
# Copy to `.env` and fill in the values.

# ---------------------------------------------------------
# LLM Configuration
# ---------------------------------------------------------
# Primary API Key for the LLM provider (e.g., OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: If you are using a different provider or custom endpoint
# LLM_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------
# MCP Server Configuration
# ---------------------------------------------------------
# NOTE: The agent prefers reading MCP connection settings from config/config.yaml.
# If you prefer to override them via environment variables, you can set them here.
# GROWW_AGENT_MCP_SERVER_URL=http://localhost:8000
# GROWW_AGENT_MCP_API_KEY=your_mcp_api_key_here

# ---------------------------------------------------------
# Frontend Configuration
# ---------------------------------------------------------
# Set this to your backend API url for Vite to communicate with the Agent
# VITE_API_BASE_URL=http://localhost:8000
